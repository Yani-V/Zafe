<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla = Crear cuenta -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fffcee"
    tools:context=".CrearCuentaActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- Logo zafe -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/logo_esquina"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/logo_zafe"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_zafe_icono_chico" />

            <!-- Título logo -->
            <ImageView
                android:id="@+id/logo_texto_esquina"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:layout_gravity="center_vertical"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/logo_zafe_texto" />
        </LinearLayout>

        <!-- Título Crear Cuenta -->
        <TextView
            android:id="@+id/txtTituloCrearCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Crear Cuenta"
            android:textColor="#7b2d3b"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Label Nombre -->
        <TextView
            android:id="@+id/txtLabelNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nombre"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Cajita Nombre -->
        <EditText
            android:id="@+id/editNombre"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_normal"
            android:hint="tu nombre"
            android:inputType="textPersonName"
            android:paddingStart="16dp"
            android:textColor="#000000"
            android:textColorHint="#8a8a8a"
            android:textSize="16sp" />

        <!-- Label Email -->
        <TextView
            android:id="@+id/txtLabelEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Email"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Cajita Email -->
        <EditText
            android:id="@+id/editEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_normal"
            android:hint="nombre@correo.com"
            android:inputType="textEmailAddress"
            android:paddingStart="16dp"
            android:textColor="#000000"
            android:textColorHint="#8a8a8a"
            android:textSize="16sp" />

        <!-- Label Contraseña -->
        <TextView
            android:id="@+id/txtLabelContrasena"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Contraseña"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Cajita Contraseña -->
        <EditText
            android:id="@+id/editContrasena"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_normal"
            android:hint="mínimo 6 caracteres"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:textColor="#000000"
            android:textColorHint="#8a8a8a"
            android:textSize="16sp" />

        <!-- Label Repetir Contraseña -->
        <TextView
            android:id="@+id/txtLabelRepetirC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Repetir contraseña"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Cajita Repetir Contraseña -->
        <EditText
            android:id="@+id/editRepetirC"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_normal"
            android:hint="repetí tu contraseña"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:textColor="#000000"
            android:textColorHint="#8a8a8a"
            android:textSize="16sp" />

        <!-- Error: contraseñas no coinciden -->
        <TextView
            android:id="@+id/txtErrorContrasena"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Las contraseñas no coinciden"
            android:textColor="#d32f2f"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Botón Crear cuenta -->
        <Button
            android:id="@+id/btnCrearCuenta"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/borde_color"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="Crear Cuenta"
            android:textAllCaps="false"
            android:textColor="#fffcee"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- ¿Ya tenés cuenta? Ingresar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- Texto = ¿Ya tenés cuenta? -->
            <TextView
                android:id="@+id/txtYaTenesCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Ya tenés cuenta?"
                android:textSize="14sp"/>

            <!-- Texto = Ingresar (clickeable) -->
             <TextView
                android:id="@+id/txtClickIngresar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                 android:layout_marginStart="4dp"
                android:text="Ingresar"
                android:textColor="#7b2d3b"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>