<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla Nuevo producto -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fffcee"
    tools:context=".NuevoProductoActivity">

    <!-- Contenedor principal -->
    <LinearLayout
        android:id="@+id/nuevoContenedorPrincipal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado: Flecha + Título a la izquierda, Logo a la derecha -->
        <LinearLayout
            android:id="@+id/nuevoEncabezado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Izquierda: Flecha volver -->
            <ImageView
                android:id="@+id/nuevoBtnVolver"
                android:layout_width="28dp"
                android:layout_height="23dp"
                android:contentDescription="Volver"
                android:clickable="true"
                app:srcCompat="@drawable/arrow_back_ios"
                app:tint="#7b2d3b" />

            <!-- Título Nuevo producto -->
            <TextView
                android:id="@+id/nuevoLabelTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Nuevo producto"
                android:textColor="#7b2d3b"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Derecha: Logo en la esquina superior derecha -->
            <LinearLayout
                android:id="@+id/nuevoContenedorLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Logo icono -->
                <ImageView
                    android:id="@+id/nuevoLogoIcono"
                    android:layout_width="60dp"
                    android:layout_height="54dp"
                    android:contentDescription="Logo Zafe"
                    app:srcCompat="@drawable/logo_zafe_icono_chico" />

                <!-- Logo texto -->
                <ImageView
                    android:id="@+id/nuevoLogoTexto"
                    android:layout_width="60dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="ZAFE"
                    app:srcCompat="@drawable/logo_zafe_texto" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nombre -->
        <TextView
            android:id="@+id/nuevoLabelNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Nombre"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Input Nombre -->
        <EditText
            android:id="@+id/nuevoInputNombre"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:ems="10"
            android:hint="Ej: Arroz 1 kg"
            android:inputType="text"
            android:background="@drawable/input_normal"
            android:paddingStart="15dp"
            android:textSize="16sp" />

        <!-- Error Nombre -->
        <TextView
            android:id="@+id/nuevoErrorNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ingresá el nombre del producto"
            android:textColor="#9b1c1c"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Código de barras -->
        <TextView
            android:id="@+id/nuevoLabelCodigoBarras"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Código de barras"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Input Código de barras -->
        <EditText
            android:id="@+id/nuevoInputCodigoBarras"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:ems="10"
            android:hint="13 dígitos"
            android:inputType="number"
            android:background="@drawable/input_normal"
            android:paddingStart="15dp"
            android:textSize="16sp" />

        <!-- Stock -->
        <LinearLayout
            android:id="@+id/nuevoContenedorStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <!-- Cantidad de Stock -->
            <LinearLayout
                android:id="@+id/nuevoContenedorCantidadStock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nuevoLabelCantidadStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cantidad de Stock"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/nuevoInputCantidadStock"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:ems="10"
                    android:hint="0"
                    android:inputType="number"
                    android:background="@drawable/input_normal"
                    android:paddingStart="15dp"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Stock mínimo -->
            <LinearLayout
                android:id="@+id/nuevoContenedorStockMinimo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nuevoLabelStockMinimo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stock mínimo"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/nuevoInputStockMinimo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:ems="10"
                    android:hint="0"
                    android:inputType="number"
                    android:background="@drawable/input_normal"
                    android:paddingStart="15dp"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Precio -->
        <TextView
            android:id="@+id/nuevoLabelPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Precio unitario"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Input Precio -->
        <EditText
            android:id="@+id/nuevoInputPrecio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:ems="10"
            android:hint="$ 0,00"
            android:inputType="numberDecimal"
            android:background="@drawable/input_normal"
            android:paddingStart="15dp"
            android:textSize="16sp" />

        <!-- Vencimiento -->
        <TextView
            android:id="@+id/nuevoLabelVencimiento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Vencimiento (opcional)"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Input Vencimiento -->
        <EditText
            android:id="@+id/nuevoInputVencimiento"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:ems="10"
            android:hint="dd/mm/aaaa"
            android:inputType="date"
            android:background="@drawable/input_normal"
            android:paddingStart="15dp"
            android:textSize="16sp" />

        <!-- Proveedor -->
        <TextView
            android:id="@+id/nuevoLabelProveedor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Proveedor"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Input Proveedor -->
        <EditText
            android:id="@+id/nuevoInputProveedor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:ems="10"
            android:hint="Nombre del proveedor"
            android:inputType="text"
            android:background="@drawable/input_normal"
            android:paddingStart="15dp"
            android:textSize="16sp" />

        <!-- Ubicación -->
        <TextView
            android:id="@+id/nuevoLabelUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Ubicación"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Input Ubicación -->
        <EditText
            android:id="@+id/nuevoInputUbicacion"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:ems="10"
            android:hint="Ciudad - Provincia"
            android:inputType="text"
            android:background="@drawable/input_normal"
            android:paddingStart="15dp"
            android:textSize="16sp" />

        <!-- Botones -->
        <LinearLayout
            android:id="@+id/nuevoContenedorBotones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <!-- Botón Cancelar -->
            <Button
                android:id="@+id/nuevoBtnCancelar"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/borde"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="Cancelar"
                android:textColor="#7b2d3b" />

            <!-- Botón Guardar -->
            <Button
                android:id="@+id/nuevoBtnGuardar"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/borde_color"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="Guardar"
                android:textColor="#fffcee" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>