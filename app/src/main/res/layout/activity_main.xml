<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla Main - Splash de Inicio -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFCEE"
    tools:context=".MainActivity" >

    <!-- Logo ZAFE -->
    <ImageView
        android:id="@+id/splash_logoZafe"
        android:layout_width="wrap_content"
        android:layout_height="140dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/logo_zafe"
        android:src="@drawable/logo_zafe_icono"
        app:layout_constraintBottom_toTopOf="@id/splash_textoZafe"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Titulo Logo Zafe -->
    <ImageView
        android:id="@+id/splash_textoZafe"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:src="@drawable/logo_zafe_texto"
        app:layout_constraintBottom_toTopOf="@id/splash_esloganZafe"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_logoZafe" />

    <!-- Eslogan Logo Zafe -->
    <TextView
        android:id="@+id/splash_esloganZafe"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:text="@string/slogan_zafe"
        android:textColor="#4A5560"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_textoZafe" />

    <!-- Barrita de Carga -->
    <ProgressBar
        android:id="@+id/splash_progreso"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:indeterminate="true"
        android:indeterminateTint="#7A2A3A"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>