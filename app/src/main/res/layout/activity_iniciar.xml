<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla = Iniciar -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fffcee"
    tools:context=".IniciarActivity">

    <!-- Logo -->
    <ImageView
        android:id="@+id/logo_esquina"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="48dp"
        android:contentDescription="@string/logo_zafe"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_zafe_icono_chico"
        app:layout_constraintBottom_toTopOf="@+id/txtTitulo"
        app:layout_constraintEnd_toStartOf="@+id/logo_texto_esquina"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo título -->
    <ImageView
        android:id="@+id/logo_texto_esquina"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_zafe_texto"
        app:layout_constraintBottom_toBottomOf="@id/logo_esquina"
        app:layout_constraintStart_toEndOf="@id/logo_esquina"
        app:layout_constraintTop_toTopOf="@id/logo_esquina" />

    <!-- Título Ingresar -->
    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="5dp"
        android:text="Ingresar"
        android:textColor="#7b2d3b"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/txtSubtitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo_esquina" />

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/txtSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="25dp"
        android:text="Entrá para ver tu inventario."
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo" />

    <!-- Mensaje de error -->
    <TextView
        android:id="@+id/txtError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email o contraseña incorrectos"
        android:textColor="#a31515"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:background="#fde8e8"
        android:padding="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/txtTitleEmail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.416"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtSubtitulo" />

    <!-- Título Email -->
    <TextView
        android:id="@+id/txtTitleEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="16dp"
        android:text="Email"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtError" />

    <!-- Cajita Email -->
    <EditText
        android:id="@+id/editTxtEmail"
        android:layout_width="354dp"
        android:layout_height="41dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/input_normal"
        android:ems="10"
        android:hint="nombre@correo.com"
        android:inputType="textEmailAddress"
        android:paddingStart="15dp"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitleEmail" />

    <!-- Título contraseña -->
    <TextView
        android:id="@+id/txtTitleContrasena"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="24dp"
        android:text="Contraseña"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTxtEmail" />

    <!-- Cajita contraseña-->
    <EditText
        android:id="@+id/editContrasena"
        android:layout_width="346dp"
        android:layout_height="47dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/input_normal"
        android:hint="tu contraseña"
        android:inputType="textPassword"
        android:paddingStart="15dp"
        android:textAlignment="textStart"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.487"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtTitleContrasena" />

    <!-- Botón Ingresar -->
    <Button
        android:id="@+id/btnIngresar"
        android:layout_width="353dp"
        android:layout_height="54dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/borde_color"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:padding="8dp"
        android:text="Ingresar"
        android:textAlignment="center"
        android:textColor="#fffcee"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editContrasena" />

    <!-- Crear cuenta -->
    <TextView
        android:id="@+id/txtCrearCuenta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:text="@string/crear_cuenta"
        android:textColor="#7b2d3b"
        android:textSize="16sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/txtNoTenesCuenta"
        app:layout_constraintStart_toEndOf="@+id/txtNoTenesCuenta"
        app:layout_constraintTop_toTopOf="@+id/txtNoTenesCuenta" />

    <!-- No tenés cuenta? -->
    <TextView
        android:id="@+id/txtNoTenesCuenta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="92dp"
        android:layout_marginTop="16dp"
        android:text="¿No tenés cuenta?"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnIngresar" />

</androidx.constraintlayout.widget.ConstraintLayout>