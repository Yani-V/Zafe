<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla Detalle del producto -->

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#fffcee"
    tools:context=".DetalleProductoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado: Flecha + Título a la izquierda, Logo a la derecha -->
        <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:gravity="center_vertical">

             <!-- Izquierda -->
             <ImageView
                  android:id="@+id/btnVolver"
                  android:layout_width="28dp"
                  android:layout_height="23dp"
                  app:srcCompat="@drawable/arrow_back_ios"
                  app:tint="#7b2d3b" />

             <TextView
                  android:id="@+id/titleDetalleProducto"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="12dp"
                  android:layout_weight="1"
                  android:text="Detalle del producto"
                  android:textColor="#7b2d3b"
                  android:textSize="20sp"
                  android:textStyle="bold" />

             <!-- Derecha: Logo en la esquina superior derecha -->
             <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:gravity="center_horizontal">

                  <ImageView
                       android:id="@+id/imageView5"
                       android:layout_width="60dp"
                       android:layout_height="54dp"
                       app:srcCompat="@drawable/logo_zafe_icono_chico" />

                  <ImageView
                       android:id="@+id/imageView6"
                       android:layout_width="60dp"
                       android:layout_height="22dp"
                       android:layout_marginTop="2dp"
                       app:srcCompat="@drawable/logo_zafe_texto" />
             </LinearLayout>
        </LinearLayout>

        <!-- Tarjeta con nombre + aviso de Vencimiento -->
        <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:background="@drawable/tarjeta_detalles"
             android:padding="16dp"
             android:layout_marginTop="16dp">

             <!-- Nombre del producto -->
             <TextView
                  android:id="@+id/txtNombreDetalle"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:text="aceite"
                  android:textSize="26sp"
                  android:textStyle="bold" />

             <!-- Estado del producto -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:background="@drawable/bg_badge_vencido"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="Vencido"
                android:textColor="#a31515"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Alerta roja de vencimiento -->
        <TextView
             android:id="@+id/txtAlerta"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:text="Venció el 17/10/2026, hace 38 días."
             android:textColor="#a31515"
             android:textStyle="bold"
             android:textSize="14sp"
             android:background="#fde8e8"
             android:padding="12dp"
             android:layout_marginTop="12dp" />

        <!-- Detalle de stock -->
        <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:layout_marginTop="12dp">

             <!-- Stock actual -->
             <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="vertical"
                  android:background="@drawable/tarjeta_detalles"
                  android:padding="16dp"
                  android:layout_marginEnd="6dp">

                  <TextView
                       android:id="@+id/txtStock"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="24"
                       android:textSize="28sp"
                       android:textStyle="bold" />

                 <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="Cantidad en stock" />

             </LinearLayout>

             <!-- Stock mínimo -->
             <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="vertical"
                  android:background="@drawable/tarjeta_detalles"
                  android:padding="16dp"
                  android:layout_marginStart="6dp">

                  <TextView
                       android:id="@+id/txtStockMinimo"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="15"
                       android:textSize="28sp"
                       android:textStyle="bold" />

                  <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="Stock mínimo" />

             </LinearLayout>
        </LinearLayout>

        <!-- Detalles del producto -->
        <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="vertical"
             android:background="@drawable/tarjeta_detalles"
             android:padding="16dp"
             android:layout_marginTop="12dp">

             <!-- Código de barras -->
             <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Código de barras" />

             <TextView
                  android:id="@+id/txtCodigo"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="7790001234567"
                  android:textStyle="bold"
                  android:textSize="18sp"
                  android:layout_marginBottom="12dp" />

             <!-- Precio unitario -->
             <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Precio unitario" />

             <TextView
                  android:id="@+id/txtPrecio"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="$ 1.800,00"
                  android:textStyle="bold"
                  android:textSize="18sp"
                  android:layout_marginBottom="12dp" />

             <!-- Vencimiento -->
             <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Vencimiento" />

             <TextView
                  android:id="@+id/txtVencimiento"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="17/10/2026"
                  android:textStyle="bold"
                  android:textSize="18sp"
                  android:layout_marginBottom="12dp" />

             <!-- Proveedor -->
             <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Proveedor" />

             <TextView
                  android:id="@+id/txtProveedor"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="HIERBASRURAL.SRL"
                  android:textStyle="bold"
                  android:textSize="18sp"
                  android:layout_marginBottom="12dp" />

             <!-- Ubicación -->
             <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Ubicación" />

             <TextView
                  android:id="@+id/txtUbicacion"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="El Bolsón - Río Negro"
                  android:textStyle="bold"
                  android:textSize="18sp" />

        </LinearLayout>

        <!-- Opción de acciones -->
        <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:layout_marginTop="20dp">

             <!-- Botón Eliminar -->
            <Button
                android:id="@+id/btnEliminarr"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/borde"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="Eliminar"
                android:textColor="#7b2d3b" />

            <Button
                android:id="@+id/btnEditar"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/borde_color"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="Editar"
                android:textColor="#fffcee" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>