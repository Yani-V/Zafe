<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla Home - Listado de Productos -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeActivity">

    <!-- Encabezado: logo, nombre y botón salir -->
    <ImageView
        android:id="@+id/home_logoZafe"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/logo_zafe"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_zafe_icono_chico"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Título logo -->
    <ImageView
        android:id="@+id/home_textoZafe"
        android:layout_width="90dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:contentDescription="ZAFE"
        android:scaleType="fitCenter"
        android:background="@drawable/logo_zafe_texto"
        app:layout_constraintBottom_toBottomOf="@id/home_logoZafe"
        app:layout_constraintStart_toEndOf="@id/home_logoZafe"
        app:layout_constraintTop_toTopOf="@id/home_logoZafe" />

    <!-- Botón Salir -->
    <Button
        android:id="@+id/home_btnSalirZafe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:background="@drawable/border_salir"
        android:backgroundTint="@null"
        android:text="Salir"
        android:textColor="#fffcee"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="@id/home_logoZafe"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/home_logoZafe" />

    <!-- Las 3 tarjetas de arriba -->
    <LinearLayout
        android:id="@+id/home_3tarjetas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/home_logoZafe">

        <!-- Tarjeta Productos -->
        <LinearLayout
            android:id="@+id/home_tarjetaProductos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/borde"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Número Productos -->
            <TextView
                android:id="@+id/home_numProductosZafe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Texto Productos -->
            <TextView
                android:id="@+id/home_labelProductos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Productos" />
        </LinearLayout>

         <!-- Tarjeta Stock Bajo -->
        <LinearLayout
            android:id="@+id/home_tarjetaStockBajoZafe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/borde"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Número Stock bajo -->
            <TextView
                android:id="@+id/home_numStockBajoZafe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="#b7791f"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Texto Stock Bajo -->
            <TextView
                android:id="@+id/home_labelStockBajo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock bajo" />
        </LinearLayout>

        <!-- Tarjeta Vencidos -->
        <LinearLayout
            android:id="@+id/home_tarjetaVencidos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/borde"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Número Vencidos -->
            <TextView
                android:id="@+id/home_numVencidosZafe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="#c0392b"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Texto Vencidos -->
            <TextView
                android:id="@+id/home_labelVencidos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vencidos" />
        </LinearLayout>
    </LinearLayout>

    <!-- Buscador -->
    <EditText
        android:id="@+id/home_buscarZafe"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/borde"
        android:hint="Buscar productos ..."
        android:inputType="text"
        android:paddingStart="18dp"
        android:textAlignment="textStart"
        android:textColor="#7a1c2e"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_3tarjetas" />

    <!-- Lista de productos (con scroll) -->
    <ScrollView
        android:id="@+id/home_scrollZafe"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/home_btnProductoZafe"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_buscarZafe">

        <!-- Contenedor de la lista de productos -->
        <LinearLayout
            android:id="@+id/home_listaProductos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1er producto cargado: ejemplo = aceite (vencido) -->
            <LinearLayout
                android:id="@+id/home_cardProducto1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/borde"
                android:clickable="true"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- Datos izquierda producto 1 -->
                <LinearLayout
                    android:id="@+id/home_datosProducto1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Nombre producto 1 -->
                    <TextView
                        android:id="@+id/home_nombreProducto1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="aceite"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Proveedor producto 1 -->
                    <TextView
                        android:id="@+id/home_proveedorProducto1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HIERBASRURAL.SRL · El Bolsón"
                        android:textColor="#b3b1b1" />

                    <!-- Stock producto 1 -->
                    <LinearLayout
                        android:id="@+id/home_stockProducto1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <!-- Cantidad producto 1 -->
                        <TextView
                            android:is="@+id/home_cantidadProducto1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24"
                            android:textStyle="bold" />

                        <!-- Mínimo producto 1 -->
                        <TextView
                            android:id="@+id/home_minimoProducto1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="/  mín. 15" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Precio y estado producto 1 -->
                <LinearLayout
                    android:id="@+id/home_precioProducto1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/home_precioPesosProducto1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$ 1.800,00"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/home_precioDolarProducto1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="US$ 1,17"
                        android:textColor="#b3b1b1" />

                    <TextView
                        android:id="@+id/home_vencimientoProducto1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="17/10/2026"
                        android:textColor="#b3b1b1" />

                    <TextView
                        android:id="@+id/home_estadoProducto1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_badge_vencido"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Vencido"
                        android:textColor="#a31515"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2do producto cargado: Ejemplo = Lavandina Ayudín (stock bajo) -->
            <LinearLayout
                android:id="@+id/home_CardProducto2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/borde"
                android:clickable="true"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- Datos izquierda producto 2 -->
                <LinearLayout
                    android:id="@+id/home_datosProducto2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Nombre producto 2 -->
                    <TextView
                        android:id="@+id/home_nombreProducto2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lavandina Ayudín 1l"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Proveedor producto 2 -->
                    <TextView
                        android:id="@+id/home_proovedorProducto2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIMPI.SRL · Buenos Aires"
                        android:textColor="#b3b1b1" />

                    <!-- Stock producto 2 -->
                    <LinearLayout
                        android:id="@+id/home_stockProducto2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <!-- Cantidad producto 2 -->
                        <TextView
                            android:id="@+id/home_cantidadProducto2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2"
                            android:textStyle="bold" />

                        <!-- Mínimo producto 2 -->
                        <TextView
                            android:id="@+id/home_minimoProducto2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="/  mín. 2" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Precio y estado producto 2 -->
                <LinearLayout
                    android:id="@+id/home_precioProducto2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/home_precioPesosProducto2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$ 1.300,00"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/home_precioDolarProducto2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="US$ 0,84"
                        android:textColor="#b3b1b1" />

                    <TextView
                        android:id="@+id/home_vencimientoProducto2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sin vencimiento"
                        android:textColor="#b3b1b1" />

                    <TextView
                        android:id="@+id/home_estadoProducto2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_badge_stock_bajo"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Stock bajo"
                        android:textColor="#7a5200"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3er producto cargado: Ejemplo = Aceite Girasol (vigente) -->
            <LinearLayout
                android:id="@+id/home_cardProducto3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/borde"
                android:clickable="true"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- Datos izquierda producto 3 -->
                <LinearLayout
                    android:id="@+id/home_datosProducto3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Nombre producto 3 -->
                    <TextView
                        android:id="@+id/home_nombreProducto3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aceite Girasol 900 ml"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Proveedor producto 3 -->
                    <TextView
                        android:id="@+id/home_proveedorProducto3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FRANKTUP.SRL · Jacobacci"
                        android:textColor="#b3b1b1" />

                    <!-- Stock producto 3 -->
                    <LinearLayout
                        android:id="@+id/home_stockProducto3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <!-- Cantidad producto 3 -->
                        <TextView
                            android:id="@+id/home_cantidadProducto3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12"
                            android:textStyle="bold" />

                        <!-- Mínimo producto 3 -->
                        <TextView
                            android:id="@+id/home_minimoProducto3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="/  mín. 3" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Precio y estado producto 3 -->
                <LinearLayout
                    android:id="@+id/home_precioProducto3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/home_precioPesosProducto3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$ 1.800,00"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/home_precioDolaProducto3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="US$ 1,17"
                        android:textColor="#b3b1b1" />

                    <TextView
                        android:id="@+id/home_vencimientoProducto3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="03/02/2027"
                        android:textColor="#b3b1b1" />

                    <TextView
                        android:id="@+id/home_estadoProducto3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_badge_vigente"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Vigente"
                        android:textColor="#1e6b32"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4to producto cargado: Ejemplo = Yerba (vigente) -->
            <LinearLayout
                android:id="@+id/home_cardProducto4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/borde"
                android:clickable="true"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- Datos izquierda producto 4 -->
                <LinearLayout
                    android:id="@+id/home_datosProducto4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Nombre producto 4 -->
                    <TextView
                        android:id="@+id/home_nombreProducto4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="yerba"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Proveedor producto 4 -->
                    <TextView
                        android:id="@+id/home_proveedorProducto4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DAUSUR.SRL · Córdoba Capital"
                        android:textColor="#b3b1b1" />

                    <!-- Stock producto 4 -->
                    <LinearLayout
                        android:id="@+id/home_stockProducto4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <!-- Cantidad producto 4 -->
                        <TextView
                            android:id="@+id/home_cantidadProducto4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="48"
                            android:textStyle="bold" />

                        <!-- Mínimo producto 4 -->
                        <TextView
                            android:id="@+id/home_minimoProducto4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="/  mín. 15" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Precio y estado producto 4 -->
                <LinearLayout
                    android:id="@+id/home_precioProducto4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/home_precioPesosProducto4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$ 4.200,00"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/home_precioDolarProducto4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="US$ 2,72"
                        android:textColor="#b3b1b1" />

                    <TextView
                        android:id="@+id/home_vencimientoProducto4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="26/11/2026"
                        android:textColor="#b3b1b1" />

                    <TextView
                        android:id="@+id/home_estadoProducto4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_badge_vigente"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Vigente"
                        android:textColor="#1e6b32"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Botón + Producto -->
    <TextView
        android:id="@+id/home_btnProductoZafe"
        android:layout_width="135dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/borde_color"
        android:gravity="center"
        android:text="+  Producto"
        android:textColor="#fffcee"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>